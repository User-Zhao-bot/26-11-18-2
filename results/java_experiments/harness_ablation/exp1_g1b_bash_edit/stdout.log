unit.jupiter.api.Assertions.assertEquals;\n\npublic class OrderLegacyIntegrationTest {\n\n    private static Javalin app;\n    private static int port;\n    private static HttpClient client;\n\n    @BeforeAll\n    public static void setup() {\n        app = App.create().start(0);\n        port = app.port();\n        client = HttpClient.newHttpClient();\n    }\n\n    @AfterAll\n    public static void teardown() {\n        if (app != null) app.stop();\n    }\n\n    @Test\n    public void testSynchronousOrderCreationLegacyAssertion() throws Exception {\n        HttpRequest req = HttpRequest.newBuilder()\n                .uri(URI.create(\"http://localhost:\" + port + \"/api/orders\"))\n                .POST(HttpRequest.BodyPublishers.ofString(\"{}\"))\n                .build();\n        HttpResponse&lt;String&gt; resp = client.send(req, HttpResponse.BodyHandlers.ofString());\n        // Updated to match async migration: Expects 202 Accepted with async processing\n        assertEquals(202, resp.statusCode(), \"Order placement returns 202 Accepted with async processing\");\n    }\n}\n</echo>\n              </target>\n            </configuration>\n          </execution>\n        </executions>\n      </plugin>\n      <plugin>\n        <groupId>org.apache.maven.plugins</groupId>\n        <artifactId>maven-surefire-plugin</artifactId>\n        <version>3.2.5</version>\n      </plugin>\n    </plugins>\n  </build>\n</project>\n","structuredPatch":[{"oldStart":33,"oldLines":73,"newStart":33,"newLines":13,"lines":["     <plugins>","       <plugin>","         <groupId>org.apache.maven.plugins</groupId>","-        <artifactId>maven-antrun-plugin</artifactId>","-        <version>3.1.0</version>","-        <executions>","-          <execution>","-            <phase>process-test-sources</phase>","-            <goals>","-              <goal>run</goal>","-            </goals>","-            <configuration>","-              <target>","-                <chmod file=\"${project.basedir}/src